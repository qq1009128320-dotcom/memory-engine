# 记忆引擎 — 生产环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env

# ============================================================================
# 必填（生产环境）
# ============================================================================

# DeepSeek API 密钥（事实提取、摘要生成需要）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# ============================================================================
# 推荐配置（按需修改）
# ============================================================================

# 数据库路径（默认项目根目录 memory.db）
# MEMORY_DB_PATH=memory.db
# 兼容写法: ENTERPRISE_MEMORY_DB=memory.db

# FAISS 索引路径
# FAISS_INDEX_PATH=faiss.index

# 嵌入模型（默认 all-MiniLM-L6-v2, 384维, ~80MB）
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM 模型
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=2048

# ============================================================================
# 飞书集成（可选）
# ============================================================================

# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret
# FEISHU_ENABLED=1

# ============================================================================
# 性能调优
# ============================================================================

# 最大并发请求数（默认 50）
# MAX_CONCURRENT_REQUESTS=50

# 单条内容最大长度（默认 50000 字符）
# MAX_CONTENT_LENGTH=50000

# ============================================================================
# 日志
# ============================================================================

# 日志级别: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# 日志文件路径（空 = 仅 stderr）
# LOG_FILE=memory-engine.log

# 日志轮转大小（字节，默认 10 MB）
# LOG_MAX_BYTES=10485760

# 保留历史日志文件数
# LOG_BACKUP_COUNT=5

# ============================================================================
# 服务配置
# ============================================================================

# MCP 服务名称
# MCP_SERVER_NAME=Memory Engine

# 监听地址/端口
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8765

# PID 锁文件
# MEMORY_PID_FILE=.memory_server.pid
