# 记忆引擎 (Memory Engine) 环境变量模板
# 复制此文件为 .env 并填入实际值

# ---- 必需 ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 可选 ----
# 数据库路径（默认 ./memory.db）
# MEMORY_DB_PATH=./memory.db

# ChromaDB 向量存储路径
# CHROMADB_PATH=./chromadb
# CHROMADB_COLLECTION=memory_tree

# 嵌入模型（默认 all-MiniLM-L6-v2，ChromaDB 内置 ONNX）
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM 配置
# LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT=60

# 飞书集成
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ENABLED=1

# MCP Server
# MCP_SERVER_NAME=Memory Engine

# 限制
# MAX_MEMORY_ROWS=100
