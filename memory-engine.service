# Create user: sudo useradd -r -s /bin/false memory
[Unit]
Description=记忆引擎 MCP Server (Memory Engine)
Documentation=https://github.com/qq1009128320-dotcom/memory-engine
After=network.target

[Service]
Type=simple
User=memory
Group=memory
WorkingDirectory=/opt/memory-engine
ExecStart=/opt/memory-engine/venv/bin/python memory_server.py
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# 资源限制
MemoryHigh=1G
MemoryMax=2G
CPUQuota=200%

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memory-engine

# P3-7: 添加关键环境变量
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/memory-engine/.env

[Install]
WantedBy=multi-user.target
