# Create user: sudo useradd -r -s /bin/false memory
[Unit]
Description=记忆引擎 MCP Server (Memory Engine)
Documentation=https://github.com/qq1009128320-dotcom/memory-engine
After=network.target

[Service]
Type=simple
User=memory
Group=memory
WorkingDirectory=/opt/memory-engine
ExecStart=/opt/memory-engine/venv/bin/python memory_server.py
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# 资源限制
# P3-⑪ 修复: MemoryHigh < MemoryMax，峰值 RSS 可能达到 ~1.2GB
MemoryHigh=1536M
MemoryMax=2560M
CPUQuota=200%

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memory-engine

# P3-5: 添加关键环境变量
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# P3-3 修复: 使用 %i 或自定义路径，部署时通过 drop-in 覆盖
# 默认值，可通过 /etc/systemd/system/memory-engine.service.d/override.conf 覆盖
EnvironmentFile=/opt/memory-engine/.env

[Install]
WantedBy=multi-user.target
